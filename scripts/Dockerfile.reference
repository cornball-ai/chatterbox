# Reference container for chatterbox R-port validation.
# chatterbox-tts 0.1.7 (PyPI) + torch 2.7.0 cu128 (Blackwell).
# Build: docker build -t chatterbox-tts:0.1.7-blackwell /tmp/cb-ref
# Use:   docker run --rm --gpus all \
#          -v ~/chatterbox/scripts:/scripts -v ~/chatterbox/outputs:/outputs \
#          chatterbox-tts:0.1.7-blackwell python /scripts/your_script.py
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-dev python3.11-distutils \
    git curl ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app
RUN uv venv --python 3.11
ENV VIRTUAL_ENV=/app/.venv PATH="/app/.venv/bin:$PATH" UV_HTTP_TIMEOUT=120

RUN uv pip install chatterbox-tts==0.1.7

# 0.1.7 pins torch 2.6.0; Blackwell (sm_120) needs the 2.7.0 cu128 wheels.
# Force-reinstall over the pin, same as the 0.1.4 blackwell image.
RUN uv pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 \
    --index-url https://download.pytorch.org/whl/cu128

ENV NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
CMD ["python"]
